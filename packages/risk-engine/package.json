{
  "name": "@ebr/risk-engine",
  "version": "0.1.0",
  "description": "Motor de Evaluacion Basada en Riesgo — implementacion unica compartida por el API y la PWA",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "decimal.js": "^10.4.3" },
  "devDependencies": { "typescript": "^5.6.3", "vitest": "^2.1.8" }
}
