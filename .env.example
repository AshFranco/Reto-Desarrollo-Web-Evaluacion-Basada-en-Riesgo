# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

# Base de datos
DATABASE_URL=postgresql://postgres:ebr@localhost:5432/ebr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ebr
POSTGRES_DB=ebr

# API
API_PORT=3000
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Almacenamiento de evidencias (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ebr-evidencias

# Correo (desarrollo: Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@digemaps.gob.do

# Frontend
VITE_API_URL=http://localhost:3000/api
