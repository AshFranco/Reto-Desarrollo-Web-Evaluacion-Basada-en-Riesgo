# ============================================================
# EBR/BPM Backend - Variables de entorno
# COPIAR a .env y completar. NUNCA subir .env real al repositorio.
# ============================================================

NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
# sslmode=require fuerza TLS en la conexión a la BD.
DATABASE_URL="postgresql://ebr_app_user:CAMBIA_ESTA_CLAVE@localhost:5432/ebr_bpm?schema=public&sslmode=require"
DIRECT_DATABASE_URL="postgresql://ebr_app_user:CAMBIA_ESTA_CLAVE@localhost:5432/ebr_bpm?sslmode=require"

# --- JWT ---
# Generar con: openssl rand -base64 64
JWT_ACCESS_SECRET="CAMBIA_ESTE_SECRETO_DE_ACCESO"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CAMBIA_ESTE_SECRETO_DE_REFRESH"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Cookies ---
COOKIE_SECRET="CAMBIA_ESTE_SECRETO_DE_COOKIES"
COOKIE_DOMAIN="localhost"

# --- Cifrado de datos sensibles en reposo (AES-256-GCM) ---
# Generar con: openssl rand -hex 32
DATA_ENCRYPTION_KEY="CAMBIA_ESTA_CLAVE_DE_32_BYTES_HEX"

# --- CORS ---
ALLOWED_ORIGINS="https://ebr-bpm.example.gob.do"

# --- Rate limiting / Redis (para throttling distribuido y bloqueo de intentos) ---
REDIS_URL="redis://localhost:6379"

# --- Login: límites de intentos ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Protección de bots (captcha) ---
CAPTCHA_PROVIDER="hcaptcha"
CAPTCHA_SECRET_KEY="CAMBIA_ESTA_CLAVE_DE_CAPTCHA"

# --- Almacenamiento de archivos (evidencias, adjuntos) ---
STORAGE_DRIVER="local"        # local | s3
STORAGE_LOCAL_PATH="./storage/uploads"
MAX_FILE_SIZE_MB=15
ALLOWED_FILE_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf,video/mp4"

# --- HTTPS / seguridad de transporte ---
FORCE_HTTPS=true
TRUST_PROXY=true

# --- Correo (para recuperación de contraseña, notificaciones) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
